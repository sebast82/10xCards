{
  "inputs": [
    {
      "id": "exa-api-key",
      "type": "promptString",
      "description": "Exa API key (dashboard.exa.ai/api-keys)",
      "password": true
    }
  ],
  "servers": {
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa,agent_run",
      "headers": {
        "x-api-key": "${input:exa-api-key}"
      }
    }
  }
}
