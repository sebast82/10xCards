+  async search(ownerId: string, term: string, sortColumn: string): Promise<DeckRow[]> {
+    const { rows } = await this.pool.query<DeckRow>(
+      `SELECT id, name, card_count, owner_id FROM decks
+       WHERE owner_id = '${ownerId}' AND name ILIKE '%${term}%'
+       ORDER BY ${sortColumn} DESC
+       LIMIT 50`,
+    );
+    return rows;
+  }
