@@ -0,0 +1,25 @@
+import express from 'express';
+import request from 'supertest';
+import { describe, expect, it, vi } from 'vitest';
+import { registerDeckRoutes } from './decksRoutes';
+
+function appWith(search: ReturnType<typeof vi.fn>) {
+  const app = express();
+  app.use((req, _res, next) => {
+    req.session = { userId: 'user-1' };
+    next();
+  });
+  registerDeckRoutes(app, { search } as never);
+  return app;
+}
+
+describe('GET /api/decks/search', () => {
+  it('returns the decks the repository finds', async () => {
+    const search = vi.fn().mockResolvedValue([{ id: 'deck-1', name: 'Spanish verbs', card_count: 42 }]);
+    const response = await request(appWith(search)).get('/api/decks/search?q=spanish');
+
+    expect(response.status).toBe(200);
+    expect(response.body.decks).toHaveLength(1);
+    expect(search).toHaveBeenCalledWith('user-1', 'spanish', 'updated_at');
+  });
+});
