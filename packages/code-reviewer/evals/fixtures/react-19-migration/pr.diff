@@ -0,0 +1,36 @@
+import { use, useEffect, useRef, useState } from 'react';
+import DeckPanel from './components/DeckPanel';
+import SearchInput from './components/SearchInput';
+import { useDeckIdFromUrl } from './routing';
+import { ThemeContext } from './theme/ThemeContext';
+
+export default function App() {
+  const { theme, toggleTheme } = use(ThemeContext);
+  const deckId = useDeckIdFromUrl();
+  const [query, setQuery] = useState('');
+  const searchRef = useRef<HTMLInputElement>(null);
+
+  // "/" focuses the search box from anywhere in the app.
+  useEffect(() => {
+    function onKeyDown(event: KeyboardEvent) {
+      if (event.key === '/' && document.activeElement !== searchRef.current) {
+        event.preventDefault();
+        searchRef.current?.focus();
+      }
+    }
+    window.addEventListener('keydown', onKeyDown);
+    return () => window.removeEventListener('keydown', onKeyDown);
+  }, []);
+
+  return (
+    <div className={`app app--${theme}`}>
+      <header className="app__header">
+        <SearchInput ref={searchRef} value={query} onChange={setQuery} placeholder="Search cards" />
+        <button type="button" onClick={toggleTheme}>
+          {theme === 'light' ? 'Dark mode' : 'Light mode'}
+        </button>
+      </header>
+      <DeckPanel deckId={deckId} query={query} />
+    </div>
+  );
+}
