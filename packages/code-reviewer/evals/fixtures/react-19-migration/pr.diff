+import { render, screen } from '@testing-library/react';
+import { beforeEach, expect, it, vi } from 'vitest';
+import { fetchDeck } from '../api/decks';
+import { deckStore } from '../store/deckStore';
+import DeckPanel from './DeckPanel';
+
+vi.mock('../api/decks');
+vi.mock('../store/deckStore');
+
+const deck = { id: 'spanish', name: 'Spanish', description: '<p>Everyday phrases</p>' };
+const cards = [
+  { id: 'c1', front: 'la manzana', back: 'the apple', dueAt: '2026-09-12T08:00:00Z' },
+  { id: 'c2', front: 'el perro', back: 'the dog', dueAt: '2026-09-13T08:00:00Z' },
+];
+const formatDueDate = (dueAt: string) => `due ${dueAt.slice(0, 10)}`;
+
+beforeEach(() => {
+  vi.mocked(fetchDeck).mockResolvedValue({ deck, cards });
+  vi.mocked(deckStore.subscribe).mockReturnValue(vi.fn());
+});
+
+function renderPanel(props: { query?: string; pageSize?: number } = {}) {
+  render(<DeckPanel deckId="spanish" query="" formatDueDate={formatDueDate} pageSize={20} {...props} />);
+}
+
+it('renders the cards of the deck with their due dates', async () => {
+  renderPanel();
+  expect(await screen.findAllByRole('listitem')).toHaveLength(2);
+  await screen.findByText('due 2026-09-12');
+});
+
+it('filters cards by the search query', async () => {
+  renderPanel({ query: 'perro' });
+  expect(await screen.findAllByRole('listitem')).toHaveLength(1);
+});
+
+it('shows only the first page of cards', async () => {
+  renderPanel({ pageSize: 1 });
+  expect(await screen.findAllByRole('listitem')).toHaveLength(1);
+});
+
+it('renders the formatted deck description', async () => {
+  renderPanel();
+  await screen.findByText('Everyday phrases');
+});
