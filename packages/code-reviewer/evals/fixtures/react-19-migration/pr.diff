@@ -0,0 +1,73 @@
+import { use, useEffect, useState } from 'react';
+import { fetchDeck } from '../api/decks';
+import { deckStore } from '../store/deckStore';
+import { ThemeContext } from '../theme/ThemeContext';
+import type { Card, Deck } from '../types';
+import { formatDueDate } from '../utils/dates';
+
+type DeckPanelProps = {
+  deckId: string;
+  query: string;
+  formatDueDate: (dueAt: string) => string;
+  pageSize: number;
+};
+
+function DeckPanel({ deckId, query, formatDueDate, pageSize }: DeckPanelProps) {
+  const { theme } = use(ThemeContext);
+  const [deck, setDeck] = useState<Deck | null>(null);
+  const [cards, setCards] = useState<Card[]>([]);
+  const [error, setError] = useState<Error | null>(null);
+
+  useEffect(() => {
+    const controller = new AbortController();
+    setDeck(null);
+    setCards([]);
+    setError(null);
+    fetchDeck(deckId, { signal: controller.signal })
+      .then((result: { deck: Deck; cards: Card[] }) => {
+        setDeck(result.deck);
+        setCards(result.cards);
+      })
+      .catch((error: Error) => {
+        if (error.name !== 'AbortError') setError(error);
+      });
+    return () => controller.abort();
+  }, [deckId]);
+
+  // Cards pushed by other devices reviewing the same deck.
+  useEffect(() => {
+    deckStore.subscribe(deckId, (updated: Card[]) => setCards(updated));
+  }, [deckId]);
+
+  if (error) return <p className="deck-panel__error">Could not load this deck.</p>;
+  if (!deck) return <p className="deck-panel__loading">Loading…</p>;
+
+  const visible = cards
+    .filter((card) => card.front.toLowerCase().includes(query.toLowerCase()))
+    .slice(0, pageSize);
+
+  return (
+    <section className={`deck-panel deck-panel--${theme}`} aria-label={deck.name}>
+      <h2>{deck.name}</h2>
+      <div className="deck-panel__description" dangerouslySetInnerHTML={{ __html: deck.description }} />
+      <ul className="deck-panel__cards">
+        {visible.map((card) => (
+          <li key={card.id}>
+            <span className="card__front">{card.front}</span>
+            <span className="card__due">{formatDueDate(card.dueAt)}</span>
+          </li>
+        ))}
+      </ul>
+      {cards.length > visible.length && (
+        <p className="deck-panel__more">{cards.length - visible.length} more cards</p>
+      )}
+    </section>
+  );
+}
+
+DeckPanel.defaultProps = {
+  formatDueDate,
+  pageSize: 20,
+};
+
+export default DeckPanel;
