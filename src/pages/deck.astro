---
import AppLayout from "@/layouts/AppLayout.astro";
import FlashcardCollection from "@/components/deck/FlashcardCollection";

const { supabase } = Astro.locals;

// Sufit chroni budżet 10 ms CPU — pełna paginacja przyjdzie z `GET /api/flashcards` w S-03.
const PAGE_SIZE = 50;

// RLS jest jedynym mechanizmem izolacji — filtr po `user_id` byłby wyłącznie wygodą.
const { data, error } = supabase
  ? await supabase
      .from("flashcards")
      .select("id, front, back, source, created_at")
      .order("created_at", { ascending: false })
      .range(0, PAGE_SIZE - 1)
  : { data: null, error: null };

const flashcards = data ?? [];
---

<AppLayout title="Moja kolekcja">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-8 p-4 py-10">
    <header class="flex flex-col gap-2">
      <h1 class="text-2xl font-bold">Moja kolekcja</h1>
      <p class="text-muted-foreground text-sm">Fiszki zapisane z przeglądu propozycji.</p>
    </header>

    {
      error && (
        <p class="text-destructive text-sm">Nie udało się wczytać kolekcji. Odśwież stronę i spróbuj ponownie.</p>
      )
    }

    {!error && <FlashcardCollection flashcards={flashcards} pageSize={PAGE_SIZE} client:load />}
  </div>
</AppLayout>
