---
import AppLayout from "@/layouts/AppLayout.astro";

const { supabase } = Astro.locals;

// Sufit chroni budżet 10 ms CPU — pełna paginacja przyjdzie z `GET /api/flashcards` w S-03.
const PAGE_SIZE = 50;

// RLS jest jedynym mechanizmem izolacji — filtr po `user_id` byłby wyłącznie wygodą.
const { data, error } = supabase
  ? await supabase
      .from("flashcards")
      .select("id, front, back, source, created_at")
      .order("created_at", { ascending: false })
      .range(0, PAGE_SIZE - 1)
  : { data: null, error: null };

const flashcards = data ?? [];

const SOURCE_LABELS: Record<string, string> = {
  ai: "AI",
  ai_edited: "AI (edytowana)",
  manual: "Ręczna",
};

const dateFormatter = new Intl.DateTimeFormat("pl-PL", { dateStyle: "medium", timeStyle: "short" });
---

<AppLayout title="Moja kolekcja">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-8 p-4 py-10">
    <header class="flex flex-col gap-2">
      <h1 class="text-2xl font-bold">Moja kolekcja</h1>
      <p class="text-muted-foreground text-sm">Fiszki zapisane z przeglądu propozycji.</p>
    </header>

    {
      error && (
        <p class="text-destructive text-sm">Nie udało się wczytać kolekcji. Odśwież stronę i spróbuj ponownie.</p>
      )
    }

    {
      !error && flashcards.length === 0 && (
        <div class="text-muted-foreground flex flex-col items-start gap-3 rounded-xl border p-6">
          <p class="text-sm">Nie masz jeszcze żadnych fiszek.</p>
          <a
            href="/generate"
            class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-md px-4 py-2 text-sm font-medium"
          >
            Generuj fiszki
          </a>
        </div>
      )
    }

    {
      flashcards.length > 0 && (
        <section class="flex flex-col gap-4">
          <span class="text-muted-foreground text-sm">
            {flashcards.length} fiszek{flashcards.length === PAGE_SIZE && " (najnowsze)"}
          </span>
          {flashcards.map((flashcard) => (
            <article class="bg-card text-card-foreground flex flex-col gap-3 rounded-xl border p-6 shadow-sm">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-muted-foreground rounded-full border px-2 py-0.5 text-xs">
                  {SOURCE_LABELS[flashcard.source] ?? flashcard.source}
                </span>
                <span class="text-muted-foreground text-xs">
                  {dateFormatter.format(new Date(flashcard.created_at))}
                </span>
              </div>
              <p class="font-medium">{flashcard.front}</p>
              <p class="text-muted-foreground text-sm">{flashcard.back}</p>
            </article>
          ))}
        </section>
      )
    }
  </div>
</AppLayout>
