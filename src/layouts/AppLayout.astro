---
import AppNavigation from "@/components/AppNavigation.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
  <AppNavigation />
  <main class="mx-auto w-full max-w-3xl px-4 py-10">
    <slot />
  </main>
</Layout>
